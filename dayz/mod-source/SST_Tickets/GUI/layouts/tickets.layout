FrameWidgetClass rootFrame {
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass pnl_frame {
   ignorepointer 0
   size 0.7 0.85
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style editor_quad
   {
    PanelWidgetClass pnl_bg {
     ignorepointer 1
     position 0 0
     size 0.995 0.995
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style rover_sim_black
     {
      TextWidgetClass Title {
       ignorepointer 1
       position 0 0.015
       size 1 0.07
       halign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Normal
       text "SST TICKETS"
       font "gui/fonts/Metron-Bold28"
       "exact text" 1
       "size to text h" 0
       "size to text v" 0
       "text halign" center
       "text valign" center
      }

      ButtonWidgetClass TabList {
       position 0.02 0.10
       size 0.30 0.05
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Editor
       text "MY TICKETS"
      }
      ButtonWidgetClass TabNew {
       position 0.34 0.10
       size 0.30 0.05
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Editor
       text "NEW TICKET"
      }
      ButtonWidgetClass RefreshButton {
       position 0.78 0.10
       size 0.20 0.05
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Editor
       text "REFRESH"
      }

      PanelWidgetClass ListPanel {
       ignorepointer 0
       position 0.005 0.17
       size 0.99 0.74
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       {
        TextWidgetClass HId {
         ignorepointer 1
         position 0.00 0
         size 0.18 0.04
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "TICKET"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" left
         "text valign" center
        }
        TextWidgetClass HSubject {
         ignorepointer 1
         position 0.18 0
         size 0.50 0.04
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "SUBJECT"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" left
         "text valign" center
        }
        TextWidgetClass HStatus {
         ignorepointer 1
         position 0.68 0
         size 0.16 0.04
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "STATUS"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" left
         "text valign" center
        }
        TextWidgetClass HCreated {
         ignorepointer 1
         position 0.84 0
         size 0.16 0.04
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "CREATED"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" right
         "text valign" center
        }

        ScrollWidgetClass ScrollContainer {
         ignorepointer 0
         position 0 0.05
         size 1 0.95
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         "Scrollbar V" 1
         {
          GridSpacerWidgetClass RowsParent {
           ignorepointer 0
           size 1 1
           hexactpos 0
           vexactpos 0
           hexactsize 0
           vexactsize 0
           Padding 1
           Margin 1
           "Size To Content H" 0
           "Size To Content V" 1
           Columns 1
           Rows 100
          }
         }
        }
       }
      }

      PanelWidgetClass FormPanel {
       ignorepointer 0
       visible 0
       position 0.04 0.17
       size 0.92 0.74
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       {
        TextWidgetClass LblSubject {
         ignorepointer 1
         position 0 0.00
         size 1 0.05
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "SUBJECT (max 80 chars)"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" left
         "text valign" center
        }
        EditBoxWidgetClass SubjectInput {
         position 0 0.06
         size 1 0.06
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style "EditBox"
         text ""
         font "gui/fonts/Metron-Light18"
        }

        TextWidgetClass LblBody {
         ignorepointer 1
         position 0 0.16
         size 1 0.05
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Normal
         text "DESCRIPTION (max 2000 chars)"
         font "gui/fonts/Metron-Bold18"
         "exact text" 1
         "text halign" left
         "text valign" center
        }
        MultilineEditBoxWidgetClass BodyInput {
         position 0 0.22
         size 1 0.62
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style "MultilineEditBox"
         text ""
         font "gui/fonts/Metron-Light18"
        }

        ButtonWidgetClass SubmitButton {
         position 0.40 0.88
         size 0.20 0.06
         hexactpos 0
         vexactpos 0
         hexactsize 0
         vexactsize 0
         style Editor
         text "SUBMIT TICKET"
        }
       }
      }

      TextWidgetClass Status {
       ignorepointer 1
       position 0 0.91
       size 1 0.04
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Normal
       text ""
       font "gui/fonts/Metron-Light18"
       "exact text" 1
       "text halign" center
       "text valign" center
      }

      ButtonWidgetClass CloseButton {
       position 0.40 0.95
       size 0.20 0.045
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       style Editor
       text "CLOSE"
      }
     }
    }
   }
  }
 }
}
