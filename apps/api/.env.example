# SST Node API Environment Configuration
# =========================================
# Copy this file to .env and configure for your server.
# All paths can be customized per-server. Use forward slashes (/) even on Windows.

# =========================================
# SERVER SETTINGS
# =========================================
PORT=3001
HOST=0.0.0.0

# Optional: directory for per-server env profiles created by Settings -> Add Server.
# By default SST uses apps/api/profiles/<server-name>.env.
# SST_API_PROFILE_ENV_DIR=./profiles

# =========================================
# STORAGE BACKEND (Local vs FTP)
# =========================================
# By default the API reads/writes files from the local filesystem.
# For hosted providers (e.g., Nitrado / HostHavoc) you can run the API elsewhere
# and point it at the game server via FTP.
#
# Values: local | ftp | sftp
STORAGE_BACKEND=local

# Optional: host provider config file (recommended for hosted servers)
# Copy apps/api/config/host-providers.example.json to apps/api/config/host-providers.json
# and select a provider via HOST_PROVIDER or the file's "active" field.
# A single API process can serve multiple providers from this file. The dashboard
# sends the selected provider name with the X-SST-Server header.
# NOTE: apps/api/.gitignore ignores config/host-providers.json by default.
# SST_API_PROVIDER_CONFIG=./config/host-providers.json
# HOST_PROVIDER=my-host

# FTP settings (required when STORAGE_BACKEND=ftp)
# NOTE: Use server paths like './Server1/SST' or '/Server1/SST' in the paths below.
# Do NOT use Windows drive paths (e.g. C:\\...) with FTP backend.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Set true for FTPS if your provider supports it.
FTP_SECURE=true

# Optional: remote root directory prefix. If you use relative paths like './Server1/SST',
# the API will resolve them under this root.
# Examples:
# FTP_ROOT=/
# FTP_ROOT=/gameservers/myserver
FTP_ROOT=/

# SFTP settings (required when STORAGE_BACKEND=sftp)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Optional: remote root directory prefix for SFTP
# If your provider shows an extra top-level prefix folder (common on hosted panels),
# set SFTP_ROOT to that prefix and keep SST_PATH relative.
# Example (HostHavoc-style):
#   Remote file shown in FileZilla: /104.234.251.153_2332/HostHavocDayZServer/SST/api/online_players.json
#   SFTP_ROOT=/104.234.251.153_2332
#   SST_PATH=HostHavocDayZServer/SST
#
# If you set SST_PATH starting with '/', SFTP_ROOT will NOT be applied.
#
# HostHavoc often uses a custom SFTP port (e.g., 8822) - set SFTP_PORT accordingly.
SFTP_ROOT=/

# API Security - set your own key or leave blank to auto-generate on startup
# If blank, SST will generate one on first run AND write it into your .env file.
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# JWT signing secret for dashboard sessions.
# If blank, SST will generate one on first run AND write it into your .env file.
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# =========================================
# FIRST LAUNCH ADMIN (Optional)
# =========================================
# If you want the API to automatically create an initial admin account on first launch,
# enable this. If disabled, the dashboard will prompt for Initial Setup via /auth/setup.
# NOTE: Set to 0 to use the Setup Wizard in the web dashboard instead.
SST_AUTO_CREATE_ADMIN=0

# Optional: set your own initial credentials. If password is blank and auto-create is enabled,
# SST will generate a strong password and write it into your .env.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# CORS - Set to your dashboard URL for production, or * for any origin
# CORS_ORIGIN=http://localhost:5173

# =========================================
# APPLICATION UPDATES
# =========================================
# SST checks GitHub Releases for updates when an admin logs in.
# Set to 1 to disable update checks.
SST_DISABLE_UPDATE_CHECK=0

# Override the GitHub repo used for release checks.
SST_UPDATE_REPO=DillanStep/SST-Public

# Advanced: allow install requests from non-local browsers.
# Keep this disabled unless SST is behind your own trusted admin-only network.
SST_ALLOW_REMOTE_UPDATE=0

# =========================================
# DISCORD SUPPORT TICKETS (Optional)
# =========================================
# Enables the built-in Discord ticket bot. Only the SST admin needs the bot token.
# Players open tickets with:
#   /ticket open steam_id:<Steam64 ID> subject:<optional issue summary>
# The Steam ID is stored with the ticket so SST can match it to server player data.
DISCORD_ENABLED=0
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: category/channel/role IDs for ticket placement and staff access.
DISCORD_TICKET_CATEGORY_ID=
DISCORD_TICKET_PANEL_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_LOG_CHANNEL_ID=

# Optional command and channel naming.
DISCORD_COMMAND_NAME=ticket
DISCORD_TICKET_CHANNEL_PREFIX=ticket
DISCORD_TICKET_DB_PATH=./data/discord_tickets_default.db

# =========================================
# SST MOD DATA PATHS (Required)
# =========================================
# Base path to your generated SST mod data folder.
# SST writes runtime data under $profile:SST in the active DayZ profile folder.
# If your server starts with -profiles=Server1, point this at C:/DayZServer/Server1/SST.
# LOCAL backend: you can use OS paths.
# FTP/SFTP backend: use server paths and forward slashes.
SST_PATH=

# Individual paths (optional - defaults to SST_PATH subfolders)
# INVENTORIES_PATH=/path/to/your/DayZ/Server/Server1/SST/inventories
# EVENTS_PATH=/path/to/your/DayZ/Server/Server1/SST/events
# LIFE_EVENTS_PATH=/path/to/your/DayZ/Server/Server1/SST/life_events
# TRADES_PATH=/path/to/your/DayZ/Server/Server1/SST/trades
# API_PATH=/path/to/your/DayZ/Server/Server1/SST/api
# ONLINE_PLAYERS_PATH - defaults to API_PATH/online_players.json if not set
# AI_POSITIONS_PATH - defaults to API_PATH/ai_positions.json if not set

# If online_players.json has not updated for this long, SST treats everyone as offline.
# This prevents stale online players after a DayZ server crash, stop, or restart.
ONLINE_PLAYERS_STALE_AFTER_MS=120000

# If ai_positions.json has not updated for this long, SST hides Expansion AI map markers.
AI_POSITIONS_STALE_AFTER_MS=120000

# =========================================
# EXPANSION MOD (Optional)
# =========================================
# Enable DayZ Expansion mod features (market, traders, banking)
# Set to 1 if you're running DayZ Expansion mod, 0 to disable
EXPANSION_ENABLED=0

# Required only if using DayZ Expansion mod for economy features
# EXPANSION_TRADERS_PATH=/path/to/your/DayZ/Server/profiles/ExpansionMod/Traders
# EXPANSION_MARKET_PATH=/path/to/your/DayZ/Server/profiles/ExpansionMod/Market
# EXPANSION_ATM_PATH=/path/to/your/DayZ/Server/profiles/ExpansionMod/ATM
# EXPANSION_AI_PATH=/path/to/your/DayZ/Server/profiles/ExpansionMod/AI
# EXPANSION_QUESTS_PATH=/path/to/your/DayZ/Server/profiles/ExpansionMod/Quests

# =========================================
# MISSION & ECONOMY FILES
# =========================================
# Mission folder - contains db/types.xml, cfgeconomycore.xml, expansion/traderzones/, etc.
# MISSION_PATH=/path/to/your/DayZ/Server/mpmissions/dayzOffline.chernarusplus

# Optional base types.xml override.
# cfgeconomycore.xml <file type="types"> additions are discovered from MISSION_PATH automatically.
# TYPES_PATH=/path/to/custom/types.xml

# =========================================
# MAP DISPLAY
# =========================================
# Bundled presets: chernarusplus | enoch | sakhal | namalsk | deerisle | esseker | hasima | custom
# If blank, SST auto-detects from MISSION_PATH where possible.
MAP_PRESET=

# Optional label for MAP_PRESET=custom
MAP_LABEL=

# Optional map image. Can be a web URL or a file under apps/web/public, e.g. /maps/livonia.jpg.
# If the image is missing, SST shows a coordinate grid so markers still work.
MAP_IMAGE_URL=

# Override if your map preset or custom image uses a different world coordinate size.
MAP_WORLD_SIZE_X=
MAP_WORLD_SIZE_Z=

# Axis flips for map images that use a different origin/orientation.
MAP_INVERT_X=0
MAP_INVERT_Z=0

# =========================================
# SERVER PROFILES (for logs)
# =========================================
# PROFILES_PATH=/path/to/your/DayZ/Server/Server1

# =========================================
# POSITION TRACKING
# =========================================
# AUTH_DB_PATH - SQLite database for dashboard users and sessions.
# For multiple API instances from one SST install, give each server its own auth DB.
# AUTH_DB_PATH=./data/server1/auth.db

# DATABASE_PATH - SQLite database for position tracking (defaults to SST/data/sst_tracking.db)
# POSITION_TRACKING_INTERVAL - How often to capture positions in milliseconds (default: 30000 = 30 seconds)

# =========================================
# DATA ARCHIVING
# =========================================
# Archives JSON data to SQLite daily and clears files to prevent server slowdown
# ARCHIVE_HOUR - Hour to run daily archive (0-23, default: 4 = 4 AM)
# ARCHIVE_MINUTE - Minute to run daily archive (0-59, default: 0)
# ARCHIVE_DB_PATH - Optional SQLite archive path (defaults to apps/api/data/archive.db)
# Archives can be queried via /archive API endpoints
