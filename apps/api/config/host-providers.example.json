{
  "$schema": "./host-providers.schema.json",
  "active": "my-host",
  "env": {
    "PORT": 3001,
    "HOST": "0.0.0.0"
  },
  "providers": {
    "my-host": {
      "backend": "sftp",
      "sftp": {
        "host": "sftp.example-host.com",
        "port": 8822,
        "username": "server-user",
        "password": "set-a-password",
        "root": "/"
      },
      "paths": {
        "SST_PATH": "/server-prefix/DayZServer/SST",
        "API_PATH": "/server-prefix/DayZServer/SST/api"
      }
    },
    "my-ftp-host": {
      "backend": "ftp",
      "ftp": {
        "host": "example.your-provider.com",
        "port": 21,
        "username": "server-user",
        "password": "set-a-password",
        "secure": false,
        "root": "/"
      },
      "paths": {
        "SST_PATH": "/profiles/SST",
        "API_PATH": "/profiles/SST/api"
      }
    }
  }
}
